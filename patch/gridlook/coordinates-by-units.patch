+function resolveLatLonFromCoordinateUnits(
+  sources: TSources["levels"][0]["datasources"],
+  variable: string,
+  datavar: zarr.Array<zarr.DataType, zarr.AsyncReadable>,
+  latitudeName: string | null,
+  longitudeName: string | null
+): TLatLonNames {
+  const coordinates = datavar.attrs.coordinates;
+  if (typeof coordinates !== "string") {
+    return { latitudeName, longitudeName };
+  }
+  for (const coordName of coordinates.split(" ").filter(Boolean)) {
+    const path = ZarrDataManager.resolveVariablePath(variable, coordName);
+    const attrs = sources[path]?.attrs;
+    if (!attrs) {
+      continue;
+    }
+    if (!latitudeName && isLatitudeVariable(path, attrs)) {
+      latitudeName = path;
+    } else if (!longitudeName && isLongitudeVariable(path, attrs)) {
+      longitudeName = path;
+    }
+  }
+  return { latitudeName, longitudeName };
+}
