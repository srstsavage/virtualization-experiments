# Copy to .env and fill in. .env is read by `docker compose` (versitygw root
# credentials) and by virtualize.py (S3 destination). Variables already set in
# the shell take precedence over .env in both.

# Credentials for writing to the S3 destination. For the local versitygw
# container these also become its root account keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 endpoint for s3:// repositories. Leave empty to use AWS itself.
AWS_ENDPOINT_URL=http://localhost:7070
