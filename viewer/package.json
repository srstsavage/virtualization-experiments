{
  "name": "icechunk-overview-maps",
  "private": true,
  "description": "Web map of the multiscale overviews in virtualize.py repositories (zarr-layer + icechunk-js)",
  "type": "module",
  "scripts": {
    "build": "esbuild main.js --bundle --format=esm --minify --sourcemap --outfile=dist/bundle.js && cp index.html node_modules/maplibre-gl/dist/maplibre-gl.css node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs dist/"
  },
  "dependencies": {
    "@carbonplan/zarr-layer": "0.12.1",
    "icechunk-js": "0.6.1",
    "maplibre-gl": "6.18.0",
    "zarrita": "0.7.5"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
